---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Importación de diagramas y fondos desde src/assets/images/
import diagramaArquitectura from '../assets/images/diagrama-arquitectura.jpg';
import iotBg1 from '../assets/images/iot-bg-1.jpg';
import iotBg2 from '../assets/images/iot-bg-2.jpg';
import iotBg3 from '../assets/images/iot-bg-3.jpg';
import iotBg4 from '../assets/images/iot-bg-4.jpg';
import iotBg5 from '../assets/images/iot-bg-5.jpg';
import iotBg6 from '../assets/images/iot-bg-6.jpg';
import iotBg7 from '../assets/images/iot-bg-7.jpg';

// Arreglo con las rutas procesadas (.src) para evitar conflictos de layout
const iotImages = [iotBg1.src, iotBg2.src, iotBg3.src, iotBg4.src, iotBg5.src, iotBg6.src, iotBg7.src];

const title = "ZAIKURAI - Domótica, Inmótica, Control e Integración IoT";
const description = "Ingeniería de automatización, supervisión SCADA/BMS y soluciones sostenibles para edificios e industrias.";

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#quienes-somos", label: "Quiénes Somos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-950 text-white font-sans antialiased selection:bg-cyan-500 selection:text-white min-h-screen">
    
    <!-- HEADER / NAVEGACIÓN -->
    <header class="fixed top-0 left-0 w-full z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Logo ZAIKURAI -->
        <a href="#inicio" class="text-2xl font-extrabold tracking-wider bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
          ZAIKURAI
        </a>

        <!-- Menú Desktop -->
        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-cyan-400 transition-colors">{link.label}</a>
          ))}
        </nav>

        <!-- Botón Menú Móvil -->
        <button id="menu-btn" aria-label="Abrir menú" class="md:hidden text-slate-300 hover:text-white focus:outline-none">
          <svg id="menu-icon-bars" class="w-7 h-7 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Menú Móvil Desplegable -->
      <div id="mobile-menu" class="hidden flex-col md:hidden bg-slate-900 border-b border-slate-800 px-4 pt-2 pb-6 space-y-4 text-slate-300">
        {navLinks.map((link) => (
          <a href={link.href} class="hover:text-cyan-400 transition-colors">{link.label}</a>
        ))}
      </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="pt-20">
      
      <!-- HERO SECTION -->
      <section id="inicio" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
        
        <!-- Slider de Imágenes de Fondo (Etiqueta img nativa con .src para evitar distorsiones) -->
        <div class="absolute inset-0 z-0">
          {iotImages.map((imgSrc, index) => (
            <img
              src={imgSrc}
              alt={`ZAIKURAI Smart Automation ${index + 1}`}
              class="hero-bg-slide absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"
            />
          ))}
          <!-- Overlays oscuros para mejorar contraste del texto -->
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/50 z-10"></div>
          <div class="absolute inset-0 bg-slate-950/40 z-10"></div>
        </div>

        <!-- Contenido Hero -->
        <div class="relative z-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-24">
          <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide uppercase bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 mb-6">
            Ecosistema IoT &amp; Inteligencia Artificial
          </span>
          
          <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white mb-6 leading-tight">
            Automatización Inteligente para <br class="hidden sm:inline" />
            <span class="bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-500 bg-clip-text text-transparent">
              Edificaciones y Control Industrial
            </span>
          </h1>
          
          <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto mb-10 font-normal leading-relaxed">
            {description}
          </p>
          
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="#contacto" class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-slate-950 bg-cyan-400 hover:bg-cyan-300 transition-all shadow-lg shadow-cyan-500/25">
              Solicitar Cotización
            </a>
            <button id="open-diagram-btn" type="button" class="w-full sm:w-auto px-8 py-4 rounded-xl font-semibold text-white bg-slate-900 hover:bg-slate-800 border border-slate-700 transition-all flex items-center justify-center gap-2">
              <span>Ver Arquitectura</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </section>

      <!-- SECCIÓN ARQUITECTURA -->
      <section id="servicios" class="py-20 bg-slate-900/50 border-t border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-3xl font-bold text-white mb-4">Arquitectura de Red y Control</h2>
          <p class="text-slate-400 max-w-2xl mx-auto mb-10">
            Conectividad multiprotocolo de alta disponibilidad (Modbus/MQTT/RS485) para monitoreo centralizado en tiempo real.
          </p>

          <div id="diagram-trigger" class="relative group max-w-4xl mx-auto rounded-2xl overflow-hidden border border-slate-800 bg-slate-900 cursor-pointer shadow-2xl p-4 sm:p-8 hover:border-cyan-500/50 transition-all">
            <Image 
              src={diagramaArquitectura} 
              alt="Diagrama de Arquitectura ZAIKURAI"
              class="w-full h-auto rounded-lg object-contain max-h-[500px] mx-auto"
            />
            <div class="mt-4 text-sm text-slate-400">Haz clic aquí para ampliar la topología de red.</div>
          </div>
        </div>
      </section>

    </main>

    <!-- MODAL DIAGRAMA -->
    <div id="diagram-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/90 backdrop-blur-md">
      <div class="relative bg-slate-900 border border-slate-800 rounded-2xl max-w-5xl w-full p-6 text-slate-100 shadow-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
          <h3 class="text-xl font-bold text-white">Topología de Red & Control ZAIKURAI</h3>
          <button id="close-modal-btn" type="button" aria-label="Cerrar modal" class="text-slate-400 hover:text-white p-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="flex items-center justify-center overflow-hidden rounded-xl border border-slate-800 p-2 bg-slate-950">
          <Image 
            src={diagramaArquitectura} 
            alt="Diagrama Ampliado ZAIKURAI"
            class="w-full h-auto object-contain max-h-[75vh]"
          />
        </div>
      </div>
    </div>

    <!-- Script de Interactividad Cliente -->
    <script src="../scripts/client.js"></script>
  </body>
</html>
      
    
