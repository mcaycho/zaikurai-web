---
// src/pages/index.astro
import { Image } from 'astro:assets';
import '../styles/global.css';

// Importación de imágenes
import diagramaArquitectura from '../assets/images/diagrama-arquitectura.jpg';
import queSomosImg from '../assets/images/quesomos.jpg';
import servicio01Img from '../assets/images/servicio01.jpg';

// Importación de proyectos
import proyect01Img from '../assets/images/proyect01.jpg';
import proyect03Img from '../assets/images/proyect03.jpg';
import proyect04Img from '../assets/images/proyect04.jpg';
import proyect05Img from '../assets/images/proyect05.jpg';

// Importación de fondos aleatorios
import iotBg1 from '../assets/images/iot-bg-1.jpg';
import iotBg2 from '../assets/images/iot-bg-2.jpg';
import iotBg3 from '../assets/images/iot-bg-3.jpg';
import iotBg4 from '../assets/images/iot-bg-4.jpg';
import iotBg5 from '../assets/images/iot-bg-5.jpg';
import iotBg6 from '../assets/images/iot-bg-6.jpg';
import iotBg7 from '../assets/images/iot-bg-7.jpg';

const iotImages = [iotBg1.src, iotBg2.src, iotBg3.src, iotBg4.src, iotBg5.src, iotBg6.src, iotBg7.src];

const proyectos = [
  { img: proyect01Img, title: "Automatización Residencial & Edificaciones", desc: "Despliegues inteligentes con control centralizado y gestión energética." },
  { img: proyect03Img, title: "Supervisión Industrial SCADA / BMS", desc: "Monitoreo en tiempo real con protocolos Modbus, MQTT y RS485." },
  { img: proyect04Img, title: "Infraestructura & Control de Acceso", desc: "Sistemas de alta disponibilidad y gestión de seguridad avanzada." },
  { img: proyect05Img, title: "Operaciones & Mantenimiento AI", desc: "Plataformas de automatización inteligente y análisis de datos." },
];

const title = "ZAIKURAI - Security & Control | Advanced Automation & AI";
const description = "Ingeniería de automatización, supervisión SCADA/BMS y soluciones sostenibles para edificios e industrias.";

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#quienes-somos", label: "Quiénes Somos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];

const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "67314ebd-b53a-4687-963d-019feefd705d";
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-slate-950 text-white font-sans antialiased selection:bg-cyan-500 selection:text-white min-h-screen">
    
    <!-- HEADER -->
    <header class="fixed top-0 left-0 w-full z-50 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="#inicio" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center font-black text-slate-950 text-lg shadow-md shadow-cyan-500/20">
            ZK
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-extrabold tracking-widest text-white leading-none">ZAIKURAI</span>
            <span class="text-[9px] tracking-wider text-cyan-400 font-bold uppercase mt-1">SECURITY &amp; CONTROL • ADVANCED AUTOMATION &amp; AI</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-6">
          {navLinks.map((link) => (
            <a href={link.href} class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors px-3 py-2 rounded-md hover:bg-slate-900/50">
              {link.label}
            </a>
          ))}
        </nav>

        <button id="menu-btn" type="button" aria-label="Abrir menú" class="md:hidden text-slate-300 hover:text-white focus:outline-none p-2">
          <svg id="menu-icon-bars" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div id="mobile-menu" class="hidden flex-col md:hidden bg-slate-950/95 border-b border-slate-800 px-6 py-4 space-y-3 text-slate-300">
        {navLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link hover:text-cyan-400 transition-colors block py-1.5 text-sm font-medium">{link.label}</a>
        ))}
      </div>
    </header>

    <!-- MAIN -->
    <main class="pt-20 scroll-pt-20">
      
      <!-- HERO (INICIO) -->
      <section id="inicio" class="relative min-h-[calc(100vh-5rem)] flex items-center justify-center overflow-hidden py-12 scroll-mt-20">
        <div class="absolute inset-0 z-0 bg-slate-950">
          {iotImages.map((imgSrc, index) => (
            <img
              src={imgSrc}
              alt={`ZAIKURAI Industrial IoT ${index + 1}`}
              class={`hero-bg-slide absolute inset-0 w-full h-full object-cover transition-all duration-1000 ease-in-out transform ${index === 0 ? 'opacity-95 scale-100' : 'opacity-0 scale-105'}`}
            />
          ))}
          <div class="absolute inset-0 bg-gradient-to-b from-slate-950/70 via-transparent to-slate-950/90 z-10 pointer-events-none"></div>
        </div>

        <div class="relative z-20 max-w-2xl w-full mx-auto px-4 sm:px-6">
          <div id="open-diagram-btn" class="group relative rounded-3xl p-[2px] bg-gradient-to-b from-cyan-400/80 via-blue-500/30 to-slate-800/80 shadow-[0_0_50px_rgba(6,182,212,0.35)] hover:shadow-[0_0_75px_rgba(6,182,212,0.55)] transition-all duration-300 cursor-pointer overflow-hidden backdrop-blur-md">
            <div class="bg-slate-950/90 rounded-[22px] overflow-hidden border border-slate-800/80 p-4 sm:p-5 text-center">
              <div class="relative rounded-xl overflow-hidden border border-slate-800 bg-slate-950 flex items-center justify-center">
                <Image src={diagramaArquitectura} alt="ZAIKURAI Security & Control System" class="w-full h-auto max-h-[500px] object-cover rounded-lg group-hover:scale-[1.02] transition-transform duration-500" />
              </div>
              <div class="mt-4 flex items-center justify-center gap-2 text-cyan-400 font-bold text-xs sm:text-sm tracking-wide">
                <span>Haz clic para ampliar la arquitectura en pantalla completa</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- QUIÉNES SOMOS -->
      <section id="quienes-somos" class="py-20 border-t border-slate-800/80 bg-slate-950 scroll-mt-20 min-h-[calc(100vh-5rem)] flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div class="text-left space-y-6">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 text-xs font-semibold uppercase tracking-wider">
                Ingeniería &amp; Control
              </div>
              <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Quiénes Somos</h2>
              <p class="text-slate-300 text-lg leading-relaxed">
                Desarrollamos e integramos soluciones avanzadas de software y hardware para domótica, inmótica y control industrial de alta fidelidad.
              </p>
              <p class="text-slate-400 text-sm leading-relaxed">
                Nuestra arquitectura abarca desde la automatización residencial inteligente hasta la supervisión de infraestructura crítica de datos, optimizando la conectividad multiprotocolo y la eficiencia operacional.
              </p>
              <div class="pt-2 flex flex-wrap gap-4">
                <div class="flex items-center gap-2 text-slate-300 text-sm font-medium">
                  <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Supervisión SCADA / BMS
                </div>
                <div class="flex items-center gap-2 text-slate-300 text-sm font-medium">
                  <span class="w-2 h-2 rounded-full bg-cyan-400"></span> Integración IoT &amp; AI
                </div>
              </div>
            </div>

            <div class="relative group">
              <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-500"></div>
              <div class="relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-900 shadow-2xl">
                <Image src={queSomosImg} alt="Acerca de ZAIKURAI" class="w-full h-auto object-cover rounded-2xl transform group-hover:scale-[1.01] transition-transform duration-500" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SERVICIOS -->
      <section id="servicios" class="py-20 bg-slate-900/40 border-t border-slate-800/80 scroll-mt-20 min-h-[calc(100vh-5rem)] flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Servicios &amp; Arquitectura de Red</h2>
            <p class="text-slate-400 text-base sm:text-lg">
              Conectividad multiprotocolo de alta disponibilidad (Modbus, MQTT, RS485) e integración de hardware especializado para monitoreo centralizado.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
            <div class="relative group order-2 lg:order-1">
              <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-500"></div>
              <div class="relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 p-2">
                <Image src={servicio01Img} alt="Servicio de Automatización ZAIKURAI" class="w-full h-auto object-cover rounded-xl" />
              </div>
            </div>

            <div class="space-y-6 order-1 lg:order-2">
              <h3 class="text-2xl font-bold text-cyan-400">Integración de Control &amp; Sensores</h3>
              <p class="text-slate-300 leading-relaxed">
                Diseñamos e implementamos redes de control adaptadas a requerimientos residenciales, comerciales e industriales con integración IoT fluida y plataformas de gestión centralizada.
              </p>
              <ul class="space-y-3 text-slate-400 text-sm">
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  Protocolos Industriales (Modbus RTU/TCP, MQTT, SNMP)
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  Ambientes de prueba e integración virtualizada
                </li>
                <li class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                  Componentes de alta confiabilidad y tableros inteligentes
                </li>
              </ul>
            </div>
          </div>

          <div id="diagram-trigger" class="relative group max-w-4xl mx-auto rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/80 cursor-pointer shadow-2xl p-4 sm:p-8 hover:border-cyan-500/50 transition-all flex flex-col items-center justify-center">
            <Image src={diagramaArquitectura} alt="Diagrama de Arquitectura ZAIKURAI" class="w-full h-auto rounded-lg object-contain max-h-[450px] mx-auto block" />
            <div class="mt-4 text-sm text-cyan-400 font-semibold tracking-wide flex items-center gap-1.5">
              <span>Haz clic para ver el esquema completo de topología</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
            </div>
          </div>
        </div>
      </section>

      <!-- PROYECTOS -->
      <section id="proyectos" class="py-20 border-t border-slate-800/80 bg-slate-950 scroll-mt-20 min-h-[calc(100vh-5rem)] flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Proyectos &amp; Despliegues</h2>
            <p class="text-slate-400 text-base sm:text-lg">Soluciones escalables desarrolladas para entornos residenciales complejos e infraestructura crítica de datos.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {proyectos.map((p) => (
              <div class="group relative rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/60 hover:border-cyan-500/50 transition-all duration-300">
                <div class="aspect-video w-full overflow-hidden bg-slate-950">
                  <Image src={p.img} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors mb-2">{p.title}</h3>
                  <p class="text-slate-400 text-sm leading-relaxed">{p.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTACTO -->
      <section id="contacto" class="py-20 border-t border-slate-800/80 bg-slate-950 scroll-mt-20 min-h-[calc(100vh-5rem)] flex items-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
          <div class="mb-12 border-b border-slate-800 pb-6">
            <h2 class="text-3xl font-extrabold text-white tracking-widest uppercase">Contáctenos</h2>
            <p class="text-xs text-slate-400 mt-1">Inicio / Contacto</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            <div class="lg:col-span-2 space-y-6">
              <h3 class="text-xl font-bold text-white uppercase tracking-wider">
                Enviar un <span class="text-cyan-400">Mensaje</span>
              </h3>

              <form id="contact-form" class="space-y-4" action="https://api.web3forms.com/submit" method="POST">
                <input type="hidden" name="access_key" value={web3FormsKey} />
                <input type="hidden" name="subject" value="Nuevo Mensaje de Contacto - ZAIKURAI Website" />
                <input type="hidden" name="from_name" value="ZAIKURAI Website Form" />
                <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <input type="text" name="nombre" placeholder="Nombre(s)*" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors" />
                  <input type="text" name="apellidos" placeholder="Apellidos*" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors" />
                  <input type="email" name="email" placeholder="Correo*" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors" />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <input type="text" name="empresa" placeholder="Empresa*" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors" />
                  <input type="tel" name="telefono" placeholder="Teléfono*" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors" />
                  <input type="tel" name="celular" placeholder="Celular" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors" />
                </div>

                <div>
                  <input type="text" name="asunto" placeholder="Asunto" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors" />
                </div>

                <div>
                  <textarea name="mensaje" rows="6" placeholder="Tu Mensaje*" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 text-sm transition-colors resize-none"></textarea>
                </div>

                <div class="flex items-center gap-4">
                  <button id="submit-btn" type="submit" class="bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold px-8 py-3 rounded-lg transition-colors text-sm uppercase tracking-wider shadow-lg shadow-cyan-500/20 disabled:opacity-50">
                    Enviar Correo
                  </button>
                  <span id="form-status" class="text-xs font-semibold"></span>
                </div>
              </form>
            </div>

            <!-- INFORMACIÓN -->
            <div class="space-y-8 bg-slate-900/40 p-6 rounded-2xl border border-slate-800/80">
              <div>
                <h3 class="text-lg font-bold text-white uppercase tracking-wider mb-2">Usted es <span class="text-cyan-400">Importante</span></h3>
                <p class="text-xs text-slate-400 leading-relaxed">
                  Si deseas contar con nuestros servicios, no dudes en comunicarte con nosotros, déjanos tus datos y nos estaremos poniendo en contacto lo más pronto posible.
                </p>
              </div>

              <div>
                <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-3">Nuestra <span class="text-cyan-400">Oficina</span></h4>
                <ul class="space-y-2.5 text-xs text-slate-300">
                  <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 text-cyan-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    <span>Jr. República de Portugal - Breña - Lima - Perú</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    <span>+(51) 01 3303630</span>
                  </li>
                  <li class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <span>info@zaikurai.com</span>
                  </li>
                </ul>
              </div>

              <div>
                <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-3">Horario de <span class="text-cyan-400">Atención</span></h4>
                <ul class="space-y-2 text-xs text-slate-300">
                  <li class="flex items-center gap-2"><span class="text-cyan-400">🕒</span><span>Lunes - Viernes: 9am a 6pm</span></li>
                  <li class="flex items-center gap-2 text-slate-500"><span>✖</span><span>Sábado: Cerrado</span></li>
                  <li class="flex items-center gap-2 text-slate-500"><span>✖</span><span>Domingo: Cerrado</span></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- MODAL DIAGRAMA -->
    <div id="diagram-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/90 backdrop-blur-md">
      <div class="relative bg-slate-900 border border-slate-800 rounded-2xl max-w-5xl w-full p-6 text-slate-100 shadow-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
          <h3 class="text-xl font-bold text-white">Topología de Red &amp; Control ZAIKURAI</h3>
          <button id="close-modal-btn" type="button" aria-label="Cerrar modal" class="text-slate-400 hover:text-white p-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <div class="flex items-center justify-center overflow-hidden rounded-xl border border-slate-800 p-2 bg-slate-950">
          <Image src={diagramaArquitectura} alt="Diagrama Ampliado ZAIKURAI" class="w-full h-auto object-contain max-h-[75vh]" />
        </div>
      </div>
    </div>

    <!-- SCRIPT ÚNICO CLIENTE -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // Rotación de fondos Hero
        const slides = document.querySelectorAll('.hero-bg-slide');
        if (slides.length > 0) {
          let currentIndex = 0;
          setInterval(() => {
            slides[currentIndex].classList.remove('opacity-95', 'scale-100');
            slides[currentIndex].classList.add('opacity-0', 'scale-105');

            let nextIndex = Math.floor(Math.random() * slides.length);
            if (nextIndex === currentIndex) {
              nextIndex = (currentIndex + 1) % slides.length;
            }
            currentIndex = nextIndex;

            slides[currentIndex].classList.remove('opacity-0', 'scale-105');
            slides[currentIndex].classList.add('opacity-95', 'scale-100');
          }, 5000);
        }

        // Menú Móvil
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const iconBars = document.getElementById('menu-icon-bars');
        const iconClose = document.getElementById('menu-icon-close');
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');

        if (menuBtn && mobileMenu) {
          const toggleMenu = () => {
            const isHidden = mobileMenu.classList.contains('hidden');
            mobileMenu.classList.toggle('hidden', !isHidden);
            mobileMenu.classList.toggle('flex', isHidden);
            iconBars?.classList.toggle('hidden', isHidden);
            iconBars?.classList.toggle('block', !isHidden);
            iconClose?.classList.toggle('hidden', !isHidden);
            iconClose?.classList.toggle('block', isHidden);
          };

          menuBtn.addEventListener('click', toggleMenu);
          mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));
        }

        // Modal Diagrama
        const openDiagramBtn = document.getElementById('open-diagram-btn');
        const diagramTrigger = document.getElementById('diagram-trigger');
        const diagramModal = document.getElementById('diagram-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');

        const toggleModal = (show: boolean) => {
          if (diagramModal) {
            diagramModal.classList.toggle('hidden', !show);
            diagramModal.classList.toggle('flex', show);
            document.body.style.overflow = show ? 'hidden' : '';
          }
        };

        if (openDiagramBtn) openDiagramBtn.addEventListener('click', () => toggleModal(true));
        if (diagramTrigger) diagramTrigger.addEventListener('click', () => toggleModal(true));
        if (closeModalBtn) closeModalBtn.addEventListener('click', () => toggleModal(false));
        if (diagramModal) {
          diagramModal.addEventListener('click', (e) => {
            if (e.target === diagramModal) toggleModal(false);
          });
        }

        // Envío de Formulario Web3Forms
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        const statusText = document.getElementById('form-status');
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

        if (form && statusText && submitBtn) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            submitBtn.disabled = true;
            submitBtn.innerText = 'ENVIANDO...';
            statusText.textContent = '';
            statusText.className = 'text-xs font-semibold text-slate-400';

            const formData = new FormData(form);

            try {
              const response = await fetch('https://api.web3forms.com/submit', {
                method: 'POST',
                body: formData,
              });

              const data = await response.json();

              if (data.success) {
                statusText.textContent = '¡Mensaje enviado con éxito!';
                statusText.className = 'text-xs font-semibold text-emerald-400';
                form.reset();
              } else {
                statusText.textContent = data.message || 'Error al enviar el formulario.';
                statusText.className = 'text-xs font-semibold text-rose-400';
              }
            } catch (error) {
              statusText.textContent = 'Error de conexión. Intente nuevamente.';
              statusText.className = 'text-xs font-semibold text-rose-400';
            } finally {
              submitBtn.disabled = false;
              submitBtn.innerText = 'ENVIAR CORREO';
            }
          });
        }
      });
    </script>
  </body>
</html>
