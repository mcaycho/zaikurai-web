---
import Layout from '../layouts/Layout.astro';

const title = "ZAIKURAI - Inmótica, Control e Integración IoT";
const description = "Ingeniería de automatización, supervisión SCADA/BMS y soluciones sostenibles para edificios e industrias.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-slate-950 text-slate-100 font-sans selection:bg-cyan-500 selection:text-slate-950">

    <!-- 1. BARRA DE NAVEGACIÓN SUPERIOR (Alineada a la derecha y con espacio generoso) -->
    <nav class="bg-[#2a2a2a] border-b border-zinc-800 sticky top-0 z-50">
      <div class="w-full max-w-[1920px] mx-auto flex items-center justify-between h-20 px-8">
        
        <!-- Logo Corporativo (Izquierda) -->
        <div class="flex items-center gap-3 shrink-0">
          <div class="w-9 h-9 rounded bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-black text-slate-950 text-xl">
           
          </div>
          <span class="text-xl font-bold tracking-wider text-white">ZAIKURAI <span class="text-xs text-cyan-400 font-mono font-normal">SECURITY & CONTROL ADVANCED HOME AUTOMATION & AI</span></span>
        </div>

        <!-- Menú Principal empujado a la extrema derecha con ml-auto y separado por pestañas -->
        <div class="hidden md:flex h-full items-center text-sm font-normal text-zinc-300 ml-auto">
          <a href="#inicio" class="bg-[#1a1a1a] text-white px-8 h-20 flex items-center border-b-2 border-cyan-500 transition">Inicio</a>
          <a href="#quienes-somos" class="hover:bg-[#1a1a1a] hover:text-white px-8 h-20 flex items-center transition">Quiénes Somos</a>
          <a href="#servicios" class="hover:bg-[#1a1a1a] hover:text-white px-8 h-20 flex items-center transition">Servicios</a>
          <a href="#proyectos" class="hover:bg-[#1a1a1a] hover:text-white px-8 h-20 flex items-center transition">Proyectos</a>
          <a href="#contacto" class="hover:bg-[#1a1a1a] hover:text-white px-8 h-20 flex items-center transition">Contacto</a>
        </div>

      </div>
    </nav> 

    <!-- 2. HERO SECTION / BANNER SLIDER: Fondo con doble compatibilidad de formato (.jpg / .png) -->
    <header id="inicio" class="relative w-full h-[75vh] md:h-[85vh] overflow-hidden bg-slate-900 border-b border-slate-800">
      
      <!-- HTML5 Video/Image Container con soporte fallback -->
      <picture class="absolute inset-0 w-full h-full">
        <!-- Si tu imagen se subió como PNG, la web la leerá aquí -->
        <source srcset="/banner-ciudad.png" type="image/png" />
        <!-- Si se subió como JPG, la leerá por defecto aquí -->
        <img 
          src="/banner-ciudad.jpg" 
          alt="Zaikurai Security & Control Advanced Home Automation & AI" 
          class="absolute inset-0 w-full h-full object-cover object-center"
          onerror="this.style.display='none'; document.getElementById('hero-fallback-bg').style.display='flex';"
        />
      </picture>

      <!-- Fondo de Respaldo Tecnológico Dinámico en caso de que la imagen no cargue instantáneamente -->
      <div id="hero-fallback-bg" class="hidden absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-cyan-950/40 flex-col items-center justify-center pointer-events-none">
        <div class="w-full h-full opacity-10 bg-[radial-gradient(#06b6d4_1px,transparent_1px)] [background-size:16px_16px]"></div>
      </div>
      
      <!-- Capa de contraste sutil para el fondo -->
      <div class="absolute inset-0 bg-black/30"></div>

      <!-- Controles visuales del Slider (Flechas J&J) -->
      <button class="absolute left-6 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center text-white/40 hover:text-white text-4xl font-light transition z-10" aria-label="Anterior">
        ‹
      </button>
      <button class="absolute right-6 top-1/2 -translate-y-1/2 w-12 h-12 flex items-center justify-center text-white/40 hover:text-white text-4xl font-light transition z-10" aria-label="Siguiente">
        ›
      </button>

      <!-- Título principal en mayúsculas delgadas en la parte inferior sobre la imagen -->
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent pt-40 pb-16 px-6">
        <div class="max-w-7xl mx-auto text-center">
          <h1 class="text-white text-3xl md:text-6xl font-extralight tracking-[0.2em] uppercase drop-shadow-[0_4px_12px_rgba(0,0,0,0.95)]">
            Automatización de Edificios
          </h1>
          <p class="text-cyan-400 font-mono text-[10px] md:text-xs uppercase tracking-[0.3em] mt-3 opacity-95">
            Zaikurai Security & Control • Advanced Home Automation & AI
          </p>
        </div>
      </div>
    </header>

    <!-- 3. QUIÉNES SOMOS -->
    <section id="quienes-somos" class="py-20 px-6 max-w-7xl mx-auto border-b border-slate-800">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-4">
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest">// Trayectoria e Integración</span>
          <h2 class="text-3xl font-bold text-white md:text-4xl">Soluciones Innovadoras en Automatización</h2>
          <p class="text-slate-400 text-sm md:text-base leading-relaxed">
            En <strong>ZAIKURAI</strong> proporcionamos soluciones integrales llave en mano orientadas al diseño, suministro y puesta en marcha de proyectos de control e inmótica. Nos enfocamos en el <strong>ahorro de energía</strong>, la reducción del impacto ambiental y la valorización de la infraestructura corporativa.
          </p>
          <p class="text-slate-400 text-sm md:text-base leading-relaxed">
            Trabajamos bajo estándares internacionales integrando instrumentación de alta gama y sistemas de supervisión distribuidos para maximizar la calidad del ambiente de trabajo y mitigar los costos por excesos de consumo.
          </p>
        </div>
        
        <div class="lg:col-span-5 grid grid-cols-2 gap-4 text-center">
          <div class="p-6 bg-slate-900 border border-slate-800/80 rounded-xl flex flex-col justify-center">
            <p class="text-4xl font-extrabold text-cyan-400">LEED</p>
            <p class="text-xs text-slate-400 mt-2 font-mono">Compatibilidad con Estándares Verdes</p>
          </div>
          <div class="p-6 bg-slate-900 border border-slate-800/80 rounded-xl flex flex-col justify-center">
            <p class="text-4xl font-extrabold text-blue-500">100%</p>
            <p class="text-xs text-slate-400 mt-2 font-mono">Soporte Post-Venta Garantizado</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. SERVICIOS Y ESPECIALIDADES -->
    <section id="servicios" class="py-20 px-6 max-w-7xl mx-auto border-b border-slate-800">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white md:text-4xl">Especialidades e Ingeniería de Control</h2>
        <p class="text-slate-400 mt-2">Equipamiento, instrumentación y software de última generación para sistemas críticos.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Tarjeta 1: Energía -->
        <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden flex flex-col justify-between group p-8 hover:border-slate-700 transition">
          <div class="space-y-3">
            <div class="text-cyan-400 text-xs font-mono uppercase tracking-wider">01 . SISTEMAS DE ENERGÍA</div>
            <h3 class="text-xl font-bold text-white">Subestaciones y Tableros</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Suministro y armado de tableros de automatización con medidores de energía inteligentes y transformadores de corriente de alta precisión.</p>
          </div>
          <div class="pt-6 font-mono text-[11px] text-slate-500 tracking-wider">// TELEMETRÍA DE POTENCIA / PROTECCIONES</div>
        </div>

        <!-- Tarjeta 2: HVAC -->
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl flex flex-col justify-between group hover:border-slate-700 transition">
          <div class="space-y-3">
            <div class="text-cyan-400 text-xs font-mono uppercase tracking-wider">02 . CLIMATIZACIÓN</div>
            <h3 class="text-xl font-bold text-white">HVAC - Aire Acondicionado</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Controladores avanzados, válvulas motorizadas, actuadores y sensores destinados a regular la carga térmica óptima y el confort ambiental.</p>
          </div>
          <div class="pt-6 font-mono text-[11px] text-slate-500 tracking-wider">// CONTROLADORES / VÁLVULAS / ACTUADORES</div>
        </div>

        <!-- Tarjeta 3: Seguridad -->
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl flex flex-col justify-between group hover:border-slate-700 transition">
          <div class="space-y-3">
            <div class="text-cyan-400 text-xs font-mono uppercase tracking-wider">03 . SEGURIDAD INTEGRAL</div>
            <h3 class="text-xl font-bold text-white">CCTV & Detección de Incendios</h3>
            <p class="text-slate-400 text-sm leading-relaxed">Integración de sistemas de videovigilancia distribuidos, control de accesos restringidos (lectores y tarjetas) y paneles centrales contra incendios.</p>
          </div>
          <div class="pt-6 font-mono text-[11px] text-slate-500 tracking-wider">// SOFTWARE DE VIDEO / DETECTORES / ACCESOS</div>
        </div>

      </div>
    </section>

    <!-- 5. PROYECTOS / PROTOCOLOS -->
    <section id="proyectos" class="py-20 px-6 max-w-7xl mx-auto">
      <div class="bg-gradient-to-r from-slate-900 to-slate-950 border border-slate-800 rounded-2xl p-8 md:p-12 grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
        <div class="md:col-span-2 space-y-4">
          <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest">Tecnología de última generación</span>
          <h3 class="text-2xl font-bold text-white md:text-3xl">Eficiencia Estratégica para su Empresa</h3>
          <p class="text-slate-400 text-sm md:text-base leading-relaxed">
            La automatización juega un papel fundamental no solo por motivos de eficiencia, confort y seguridad, sino también como parte estratégica en la imagen de la organización, certificando que su empresa se preocupa por crecer tecnológicamente bajo políticas sostenibles.
          </p>
        </div>
        <div class="flex flex-col items-start md:items-end justify-center">
          <div class="font-mono text-xs text-slate-400 border border-slate-800 bg-slate-950 px-4 py-2 rounded-lg">
            Protocolos Soportados: <br/>
            <span class="text-cyan-400 font-bold">BACnet, Modbus, MQTT, Zigbee 3.0</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. CONTACTO -->
    <section id="contacto" class="py-20 px-6 max-w-4xl mx-auto border-t border-slate-800">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        
        <div class="space-y-6">
          <div>
            <h2 class="text-3xl font-bold text-white">Contáctanos</h2>
            <p class="text-slate-400 mt-2 text-sm">Comunícate con nuestro departamento de ingeniería para cotizaciones y soporte técnico.</p>
          </div>
          <div class="space-y-3 font-sans text-sm text-slate-300">
            <p class="flex items-center gap-2">
              <span class="text-cyan-400 font-mono">📍</span> Lima, Perú
            </p>
            <p class="flex items-center gap-2">
              <span class="text-cyan-400 font-mono">✉️</span> info@zaikurai.com
            </p>
          </div>
        </div>

        <form id="contact-form" class="space-y-4 bg-slate-900 p-6 rounded-xl border border-slate-800 shadow-xl">
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1 uppercase tracking-wider">Nombre / Empresa</label>
            <input type="text" name="empresa" required class="w-full px-4 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white text-sm focus:outline-none focus:border-cyan-500" placeholder="Ej. Corporación Constructora" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1 uppercase tracking-wider">Correo Electrónico</label>
            <input type="email" name="email" required class="w-full px-4 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white text-sm focus:outline-none focus:border-cyan-500" placeholder="ingenieria@empresa.com" />
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-400 mb-1 uppercase tracking-wider">Mensaje Técnica</label>
            <textarea name="mensaje" rows="4" required class="w-full px-4 py-2 bg-slate-950 border border-slate-800 rounded-lg text-white text-sm focus:outline-none focus:border-cyan-500" placeholder="Describa los requerimientos de automatización..."></textarea>
          </div>
          <button type="submit" class="w-full py-2.5 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-lg transition text-sm tracking-wide">
            Enviar Requerimiento
          </button>
        </form>

      </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-xs bg-slate-950 font-mono">
      <p>&copy; {new Date().getFullYear()} ZAIKURAI . Todos los derechos reservados.</p>
      <p class="text-slate-600 mt-1 text-[10px]">Ingeniería para Soluciones Sostenibles en Control e Inmótica.</p>
    </footer>

  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    console.log("Datos enviados:", Object.fromEntries(formData));
    alert("Requerimiento recibido de forma correcta. Un ingeniero de proyectos se comunicará a la brevedad.");
    form.reset();
  });
</script>
