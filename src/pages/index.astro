---
import Layout from '../layouts/Layout.astro';

const title = "ZAIKURAI - Control, Automatización e Integración Industrial";
const description = "Soluciones integrales de automatización, tableros de control, medición energética e inmótica B2B.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-slate-950 text-slate-100 font-sans">
    
    <!-- NAVBAR SUPERIOR -->
    <nav class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-2xl font-black tracking-wider text-cyan-400">ZAIKURAI</span>
          <span class="text-xs px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-mono hidden sm:inline-block">TECH CONTROL</span>
        </div>
        <div class="hidden md:flex gap-8 text-sm font-medium text-slate-300">
          <a href="#servicios" class="hover:text-cyan-400 transition">Servicios</a>
          <a href="#soluciones" class="hover:text-cyan-400 transition">Soluciones</a>
          <a href="#protocolos" class="hover:text-cyan-400 transition">Integración</a>
          <a href="#contacto" class="hover:text-cyan-400 transition">Contacto</a>
        </div>
        <a href="#contacto" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-md text-sm transition">
          Cotizar Proyecto
        </a>
      </div>
    </nav>

    <!-- HERO SECTION (ESTILO INGENIERÍA / INDUSTRIAL) -->
    <header class="relative border-b border-slate-800 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 py-20 px-6">
      <div class="max-w-5xl mx-auto text-center space-y-6">
        <span class="inline-block px-3 py-1 text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950/80 border border-cyan-800/60 rounded-full">
          Ingeniería & Control de Procesos
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Soluciones de Control, Automatización e <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Inmótica B2B</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-400 max-w-3xl mx-auto">
          Diseño, integración y armado de tableros de control, monitoreo energético y sistemas IoT adaptados a la infraestructura de tu empresa.
        </p>
        <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#servicios" class="px-6 py-3 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold transition">
            Ver Portafolio de Servicios
          </a>
          <a href="#contacto" class="px-6 py-3 rounded-lg border border-slate-700 hover:bg-slate-800 text-slate-300 font-semibold transition">
            Asesoría Técnica
          </a>
        </div>
      </div>
    </header>

    <!-- ÁREAS PRINCIPALES DE TRABAJO -->
    <section id="servicios" class="py-20 px-6 max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white">Servicios de Ingeniería y Control</h2>
        <p class="text-slate-400 mt-2">Cubrimos desde la automatización de campo hasta la supervisión centralizada.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Servicio 1 -->
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl space-y-4 hover:border-cyan-500/50 transition">
          <div class="w-12 h-12 rounded-lg bg-cyan-950 flex items-center justify-center text-cyan-400 font-bold text-xl">⚙️</div>
          <h3 class="text-xl font-bold text-white">Tableros & Control Eléctrico</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Diseño e integración de tableros de automatización, protección eléctrica inteligente, conmutación y maniobra para proyectos de infraestructura.
          </p>
        </div>

        <!-- Servicio 2 -->
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl space-y-4 hover:border-cyan-500/50 transition">
          <div class="w-12 h-12 rounded-lg bg-cyan-950 flex items-center justify-center text-cyan-400 font-bold text-xl">📊</div>
          <h3 class="text-xl font-bold text-white">Medición y Ahorro Energético</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Sistemas de telemetría trifásica y monofásica para el monitoreo de consumo eléctrico en tiempo real, detección de fallas y reporte de eficiencia.
          </p>
        </div>

        <!-- Servicio 3 -->
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl space-y-4 hover:border-cyan-500/50 transition">
          <div class="w-12 h-12 rounded-lg bg-cyan-950 flex items-center justify-center text-cyan-400 font-bold text-xl">🌐</div>
          <h3 class="text-xl font-bold text-white">Inmótica e Integración IoT</h3>
          <p class="text-slate-400 text-sm leading-relaxed">
            Control centralizado de climatización (HVAC), iluminación automatizada, accesos e integración retrofitted en edificios y hoteles.
          </p>
        </div>
      </div>
    </section>

    <!-- PROTOCOLOS E INTEGRACIÓN TÉCNICA -->
    <section id="protocolos" class="py-16 bg-slate-900/50 border-y border-slate-800">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <h3 class="text-sm font-mono uppercase tracking-widest text-slate-400 mb-8">Compatibilidad e Integración Multi-Protocolo</h3>
        <div class="flex flex-wrap justify-center gap-8 items-center text-slate-300 font-mono text-sm">
          <span class="px-4 py-2 bg-slate-950 border border-slate-800 rounded-md">MODBUS RTU / TCP</span>
          <span class="px-4 py-2 bg-slate-950 border border-slate-800 rounded-md">MQTT / MQTTS</span>
          <span class="px-4 py-2 bg-slate-950 border border-slate-800 rounded-md">ZIGBEE 3.0</span>
          <span class="px-4 py-2 bg-slate-950 border border-slate-800 rounded-md">SNMP v3</span>
          <span class="px-4 py-2 bg-slate-950 border border-slate-800 rounded-md">RS485</span>
        </div>
      </div>
    </section>

    <!-- SOLUCIONES POR SECTOR -->
    <section id="soluciones" class="py-20 px-6 max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white">Sectores Atendidos</h2>
        <p class="text-slate-400 mt-2">Adaptamos la tecnología de control al perfil operativo de cada inmueble.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl flex gap-4">
          <div class="text-cyan-400 text-2xl font-bold">01</div>
          <div>
            <h4 class="text-lg font-bold text-white mb-1">Hoteles & Alojamiento</h4>
            <p class="text-slate-400 text-sm">Gestión eficiente de climatización por presencia, control de accesos e indicadores de consumo por habitación.</p>
          </div>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl flex gap-4">
          <div class="text-cyan-400 text-2xl font-bold">02</div>
          <div>
            <h4 class="text-lg font-bold text-white mb-1">Edificios Corporativos y Residenciales</h4>
            <p class="text-slate-400 text-sm">Automatización de bombas de agua, iluminación de áreas comunes y medición centralizada de energía.</p>
          </div>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl flex gap-4">
          <div class="text-cyan-400 text-2xl font-bold">03</div>
          <div>
            <h4 class="text-lg font-bold text-white mb-1">Comercio & Retail</h4>
            <p class="text-slate-400 text-sm">Encendidos y apagados programados, control de cargas críticas y alertas de variación de temperatura.</p>
          </div>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl flex gap-4">
          <div class="text-cyan-400 text-2xl font-bold">04</div>
          <div>
            <h4 class="text-lg font-bold text-white mb-1">Proyectos Especiales a Medida</h4>
            <p class="text-slate-400 text-sm">Desarrollo e integración de hardware/software personalizado para requerimientos específicos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMULARIO DE CONTACTO -->
    <section id="contacto" class="py-20 px-6 max-w-3xl mx-auto border-t border-slate-800">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-white">Contacto Técnico</h2>
        <p class="text-slate-400 mt-2">Envíanos las especificaciones o alcance de tu proyecto para una evaluación técnica.</p>
      </div>

      <form class="space-y-4 bg-slate-900 p-8 rounded-xl border border-slate-800" onsubmit="event.preventDefault();">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Empresa / Nombre</label>
          <input type="text" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-cyan-500 font-sans" placeholder="Ej. Inmobiliaria o Constructora" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Correo de Contacto</label>
          <input type="email" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-cyan-500 font-sans" placeholder="contacto@empresa.com" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Requerimiento Técnico</label>
          <textarea rows="4" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-cyan-500 font-sans" placeholder="Describe brevemente el tablero, sistema o instalación que requieres..."></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-lg transition">
          Enviar Consulta Técnica
        </button>
      </form>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm bg-slate-950">
      <p>&copy; {new Date().getFullYear()} ZAIKURAI. Todos los derechos reservados.</p>
    </footer>

  </main>
</Layout>
