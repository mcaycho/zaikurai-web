---
import Layout from '../layouts/Layout.astro';

const title = "ZAIKURAI - Inmótica, Control e Integración IoT";
const description = "Plataforma de automatización, supervisión SCADA/BMS y gestión energética para edificios, hoteles e industria.";
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-slate-950 text-slate-100 font-sans">

    <!-- BARRA DE NAVEGACIÓN SUPERIOR (ESTILO J&J) -->
    <nav class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <!-- Logo Branding -->
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-black text-slate-950 text-lg">
            Z
          </div>
          <span class="text-xl font-bold tracking-wider text-white">ZAIKURAI <span class="text-xs text-cyan-400 font-mono font-normal">TECH</span></span>
        </div>

        <!-- Menú Principal -->
        <div class="hidden md:flex gap-8 text-sm font-medium text-slate-300">
          <a href="#inicio" class="hover:text-cyan-400 transition">Inicio</a>
          <a href="#quienes-somos" class="hover:text-cyan-400 transition">Quiénes Somos</a>
          <a href="#servicios" class="hover:text-cyan-400 transition">Servicios</a>
          <a href="#soluciones" class="hover:text-cyan-400 transition">Soluciones</a>
          <a href="#contacto" class="hover:text-cyan-400 transition">Contacto</a>
        </div>

        <a href="#contacto" class="px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-md text-sm transition">
          Cotizar
        </a>
      </div>
    </nav>

    <!-- HERO SECTION CON MOCKUP DE PANTALLAS DE CONTROL (SCADA / DASHBOARD) -->
    <header id="inicio" class="relative overflow-hidden border-b border-slate-800 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 py-16 px-6">
      <div class="max-w-7xl mx-auto space-y-12">
        
        <!-- Texto del Hero -->
        <div class="text-center space-y-4 max-w-3xl mx-auto">
          <span class="inline-block px-3 py-1 text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950/80 border border-cyan-800/60 rounded-full">
            Supervisión & Control Centralizado
          </span>
          <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Gestión Inteligente de Infraestructura y <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Sistemas SCADA / IoT</span>
          </h1>
          <p class="text-slate-400 text-base md:text-lg">
            Monitoreo en tiempo real de temperatura, HVAC, consumo eléctrico trifásico y automatización de procesos para inmuebles e industria.
          </p>
        </div>

        <!-- REPLICACIÓN DEL MOCKUP VISUAL (PANTALLAS SIMULADAS SCADA/DASHBOARD) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          
          <!-- Pantalla Principal (Estilo Dashboard de Control HVAC / Proceso) -->
          <div class="lg:col-span-8 bg-slate-900 border border-slate-700 rounded-xl overflow-hidden shadow-2xl shadow-cyan-950/50">
            <!-- Barra superior del monitor simulado -->
            <div class="bg-slate-800 px-4 py-2 flex items-center justify-between border-b border-slate-700 text-xs font-mono text-slate-400">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
                <span class="ml-2 text-slate-300 font-semibold">ZAIKURAI Control Center v2.4 - BMS/SCADA</span>
              </div>
              <span>ONLINE | Modbus / MQTT Active</span>
            </div>

            <!-- Contenido Visual de la Pantalla Principal -->
            <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-4 bg-slate-950/90 font-mono text-xs">
              
              <!-- Árbol de Sensores / Diagrama -->
              <div class="p-3 bg-slate-900 border border-slate-800 rounded space-y-2">
                <p class="text-cyan-400 font-bold border-b border-slate-800 pb-1">// Zonas HVAC</p>
                <div class="text-slate-300 space-y-1">
                  <p class="text-emerald-400">✔ Chiller Principal [21.5°C]</p>
                  <p class="text-emerald-400">✔ Bomba de Agua 01 [RUN]</p>
                  <p class="text-yellow-400">⚠ Tablero Trifásico [88% Cap]</p>
                  <p class="text-slate-500">↳ Zona 04 - Sensor Humedad</p>
                </div>
              </div>

              <!-- Gráfico Simulado de Telemetría -->
              <div class="md:col-span-2 p-3 bg-slate-900 border border-slate-800 rounded flex flex-col justify-between">
                <div class="flex justify-between text-slate-400">
                  <span>Monitoreo de Carga Térmica (kWh)</span>
                  <span class="text-cyan-400">350 kW/h</span>
                </div>
                <div class="h-28 flex items-end gap-2 pt-4">
                  <div class="w-1/6 bg-cyan-950 border border-cyan-500 h-[40%] rounded-t"></div>
                  <div class="w-1/6 bg-cyan-950 border border-cyan-500 h-[65%] rounded-t"></div>
                  <div class="w-1/6 bg-cyan-950 border border-cyan-500 h-[50%] rounded-t"></div>
                  <div class="w-1/6 bg-cyan-500 h-[85%] rounded-t"></div>
                  <div class="w-1/6 bg-cyan-950 border border-cyan-500 h-[60%] rounded-t"></div>
                  <div class="w-1/6 bg-cyan-950 border border-cyan-500 h-[75%] rounded-t"></div>
                </div>
              </div>

            </div>
          </div>

          <!-- Pantalla Secundaria (Monitor Lateral / Tablet de Operación) -->
          <div class="lg:col-span-4 bg-slate-900 border border-slate-700 rounded-xl overflow-hidden shadow-xl">
            <div class="bg-slate-800 px-4 py-2 border-b border-slate-700 text-xs font-mono text-slate-300">
              Terminal HMI / Tablet de Mantenimiento
            </div>
            <div class="p-6 bg-slate-950/90 space-y-4">
              <div class="p-3 bg-slate-900 border border-slate-800 rounded">
                <p class="text-xs font-mono text-slate-400">Estado del Sistema</p>
                <p class="text-lg font-bold text-emerald-400 mt-1">Operacional 100%</p>
              </div>
              <div class="p-3 bg-slate-900 border border-slate-800 rounded space-y-2 text-xs text-slate-300">
                <p class="font-bold text-cyan-400">Telemetría Directa</p>
                <p>• RS485 / Modbus: Conectado</p>
                <p>• Gateway Zigbee 3.0: OK</p>
                <p>• Protocolo SNMP v3: Activo</p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </header>

    <!-- QUIÉNES SOMOS -->
    <section id="quienes-somos" class="py-20 px-6 max-w-7xl mx-auto border-b border-slate-800">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-4">
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest">// Especialistas en Inmótica</span>
          <h2 class="text-3xl font-bold text-white">Ingeniería e Integración de Control</h2>
          <p class="text-slate-400 text-sm leading-relaxed">
            En **ZAIKURAI** nos especializamos en transformar infraestructuras tradicionales en sistemas altamente eficientes, integrando sensores, tableros eléctricos y software de gestión en tiempo real.
          </p>
          <p class="text-slate-400 text-sm leading-relaxed">
            Nuestras soluciones abarcan desde el monitoreo de energía y control de climatización en hoteles hasta la automatización industrial mediante protocolos estándar.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4 text-center">
          <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl">
            <p class="text-3xl font-extrabold text-cyan-400">+30%</p>
            <p class="text-xs text-slate-400 mt-1">Ahorro Energético Promedio</p>
          </div>
          <div class="p-6 bg-slate-900 border border-slate-800 rounded-xl">
            <p class="text-3xl font-extrabold text-cyan-400">24/7</p>
            <p class="text-xs text-slate-400 mt-1">Monitoreo & Telemetría</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="py-20 px-6 max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl font-bold text-white">Nuestros Servicios</h2>
        <p class="text-slate-400 mt-2">Soluciones completas de ingeniería de control y automatización.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl space-y-3">
          <div class="text-cyan-400 text-2xl font-bold">01</div>
          <h3 class="text-xl font-bold text-white">Tableros de Automatización</h3>
          <p class="text-slate-400 text-sm">Armado e integración de tableros eléctricos con protecciones inteligentes, conmutación y medidores trifásicos.</p>
        </div>
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl space-y-3">
          <div class="text-cyan-400 text-2xl font-bold">02</div>
          <h3 class="text-xl font-bold text-white">Sistemas BMS / SCADA</h3>
          <p class="text-slate-400 text-sm">Supervisión centralizada de climatización (HVAC), bombas de agua, iluminación y sensores de seguridad.</p>
        </div>
        <div class="p-8 bg-slate-900 border border-slate-800 rounded-xl space-y-3">
          <div class="text-cyan-400 text-2xl font-bold">03</div>
          <h3 class="text-xl font-bold text-white">Integración Retrofit IoT</h3>
          <p class="text-slate-400 text-sm">Modernización de edificios e instalaciones existentes sin necesidad de cambiar la cableización existente.</p>
        </div>
      </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="py-20 px-6 max-w-3xl mx-auto border-t border-slate-800">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-white">Contáctanos</h2>
        <p class="text-slate-400 mt-2">Solicita una asesoría o cotización para tu proyecto.</p>
      </div>

      <form class="space-y-4 bg-slate-900 p-8 rounded-xl border border-slate-800" onsubmit="event.preventDefault();">
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Nombre / Empresa</label>
          <input type="text" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-cyan-500" placeholder="Ej. Constructora X" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Correo Electrónico</label>
          <input type="email" required class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-cyan-500" placeholder="contacto@empresa.com" />
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-1">Mensaje o Requerimiento</label>
          <textarea rows="4" class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-lg text-white focus:outline-none focus:border-cyan-500" placeholder="Describe tu proyecto..."></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold rounded-lg transition">
          Enviar Mensaje
        </button>
      </form>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-slate-800 py-8 text-center text-slate-500 text-sm bg-slate-950">
      <p>&copy; {new Date().getFullYear()} ZAIKURAI. Todos los derechos reservados.</p>
    </footer>

  </main>
</Layout>
