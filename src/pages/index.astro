---
// src/pages/index.astro
import { Image } from 'astro:assets';
import '../styles/global.css';

// Importación del diagrama de arquitectura central
import diagramaArquitectura from '../assets/images/diagrama-arquitectura.jpg';

// Importación de imágenes para el carrusel aleatorio de fondo
import iotBg1 from '../assets/images/iot-bg-1.jpg';
import iotBg2 from '../assets/images/iot-bg-2.jpg';
import iotBg3 from '../assets/images/iot-bg-3.jpg';
import iotBg4 from '../assets/images/iot-bg-4.jpg';
import iotBg5 from '../assets/images/iot-bg-5.jpg';
import iotBg6 from '../assets/images/iot-bg-6.jpg';
import iotBg7 from '../assets/images/iot-bg-7.jpg';

const iotImages = [
  iotBg1.src,
  iotBg2.src,
  iotBg3.src,
  iotBg4.src,
  iotBg5.src,
  iotBg6.src,
  iotBg7.src
];

const title = "ZAIKURAI - Security & Control | Advanced Automation & AI";
const description = "Ingeniería de automatización, supervisión SCADA/BMS y soluciones sostenibles para edificios e industrias.";

const navLinks = [
  { href: "#inicio", label: "Inicio" },
  { href: "#quienes-somos", label: "Quiénes Somos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-slate-950 text-white font-sans antialiased selection:bg-cyan-500 selection:text-white min-h-screen">
    
    <!-- HEADER / ENCABEZADO -->
    <header class="fixed top-0 left-0 w-full z-50 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/60">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Isotipo ZK + Branding ZAIKURAI -->
        <a href="#inicio" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center font-black text-slate-950 text-lg shadow-md shadow-cyan-500/20">
            ZK
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-extrabold tracking-widest text-white leading-none">
              ZAIKURAI
            </span>
            <span class="text-[9px] tracking-wider text-cyan-400 font-bold uppercase mt-1">
              SECURITY &amp; CONTROL • ADVANCED AUTOMATION &amp; AI
            </span>
          </div>
        </a>

        <!-- Menú de Navegación Desktop -->
        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-cyan-400 transition-colors py-2">{link.label}</a>
          ))}
        </nav>

        <!-- Botón Menú Móvil -->
        <button id="menu-btn" type="button" aria-label="Abrir menú" class="md:hidden text-slate-300 hover:text-white focus:outline-none p-2">
          <svg id="menu-icon-bars" class="w-6 h-6 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Menú Móvil -->
      <div id="mobile-menu" class="hidden flex-col md:hidden bg-slate-950 border-b border-slate-800 px-6 py-4 space-y-3 text-slate-300">
        {navLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link hover:text-cyan-400 transition-colors block py-1">{link.label}</a>
        ))}
      </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="pt-20">
      
      <!-- HERO SECTION -->
      <section id="inicio" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden py-12 sm:py-16">
        
        <!-- Carrusel de Fondos IoT en Bucle Aleatorio -->
        <div class="absolute inset-0 z-0">
          {iotImages.map((imgSrc, index) => (
            <img
              src={imgSrc}
              alt={`ZAIKURAI Smart Automation ${index + 1}`}
              class={`hero-bg-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${index === 0 ? 'opacity-80' : 'opacity-0'}`}
            />
          ))}
          <!-- Filtro de Oscurecimiento -->
          <div class="absolute inset-0 bg-slate-950/60 z-10"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-slate-950/80 z-10"></div>
        </div>

        <!-- Tarjeta Central: Diagrama de Arquitectura ZAIKURAI -->
        <div class="relative z-20 max-w-3xl w-full mx-auto px-4 sm:px-6">
          <div id="open-diagram-btn" class="group relative rounded-3xl p-1 bg-gradient-to-b from-cyan-500/50 via-blue-500/30 to-slate-800/60 shadow-[0_0_60px_rgba(6,182,212,0.3)] hover:shadow-[0_0_80px_rgba(6,182,212,0.45)] transition-all duration-300 cursor-pointer overflow-hidden backdrop-blur-md">
            
            <div class="bg-slate-900/90 rounded-[22px] overflow-hidden border border-slate-700/60 p-4 sm:p-6 text-center">
              
              <!-- Diagrama de Arquitectura Integrado -->
              <div class="relative rounded-xl overflow-hidden border border-slate-800 bg-slate-950/90 p-2">
                <Image 
                  src={diagramaArquitectura} 
                  alt="Diagrama de Arquitectura ZAIKURAI" 
                  class="w-full h-auto max-h-[550px] object-contain mx-auto rounded-lg group-hover:scale-[1.02] transition-transform duration-500"
                />
              </div>

              <div class="mt-4 flex items-center justify-center gap-2 text-cyan-400 font-bold text-sm tracking-wide">
                <span>Haz clic para ampliar la arquitectura en pantalla completa</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </div>

            </div>

          </div>
        </div>
      </section>

      <!-- SECCIÓN QUIÉNES SOMOS -->
      <section id="quienes-somos" class="py-20 border-t border-slate-800/80 bg-slate-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-3xl font-bold text-white mb-4">Quiénes Somos</h2>
          <p class="text-slate-400 max-w-3xl mx-auto">
            Desarrollamos e integramos soluciones avanzadas de software y hardware para domótica, inmótica y control industrial de alta fidelidad.
          </p>
        </div>
      </section>

      <!-- SECCIÓN SERVICIOS -->
      <section id="servicios" class="py-20 bg-slate-900/40 border-t border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-3xl font-bold text-white mb-4">Arquitectura de Red y Control</h2>
          <p class="text-slate-400 max-w-2xl mx-auto mb-10">
            Conectividad multiprotocolo de alta disponibilidad (Modbus, MQTT, RS485) para monitoreo centralizado.
          </p>

          <div id="diagram-trigger" class="relative group max-w-4xl mx-auto rounded-2xl overflow-hidden border border-slate-800 bg-slate-900/80 cursor-pointer shadow-2xl p-4 sm:p-8 hover:border-cyan-500/50 transition-all flex flex-col items-center justify-center">
            <Image 
              src={diagramaArquitectura} 
              alt="Diagrama de Arquitectura ZAIKURAI"
              class="w-full h-auto rounded-lg object-contain max-h-[500px] mx-auto block"
            />
            <div class="mt-4 text-sm text-cyan-400 font-semibold tracking-wide flex items-center gap-1.5">
              <span>Haz clic para ampliar la topología</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
              </svg>
            </div>
          </div>
        </div>
      </section>

      <!-- SECCIÓN PROYECTOS -->
      <section id="proyectos" class="py-20 border-t border-slate-800/80 bg-slate-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-3xl font-bold text-white mb-4">Proyectos &amp; Despliegues</h2>
          <p class="text-slate-400 max-w-2xl mx-auto">
            Soluciones escalables desde departamentos residenciales hasta infraestructura crítica de centros de datos.
          </p>
        </div>
      </section>

      <!-- SECCIÓN CONTACTO -->
      <section id="contacto" class="py-20 border-t border-slate-800/80 bg-slate-900/30">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-3xl font-bold text-white mb-4">Contacto</h2>
          <p class="text-slate-400 mb-8">¿Tienes un proyecto en mente? Contáctanos para asesoría técnica especializada.</p>
          <a href="mailto:contacto@zaikurai.com" class="inline-block px-8 py-4 rounded-xl font-bold text-slate-950 bg-cyan-400 hover:bg-cyan-300 transition-all shadow-lg shadow-cyan-500/20">
            Enviar Mensaje
          </a>
        </div>
      </section>

    </main>

    <!-- MODAL DIAGRAMA AMPLIADO -->
    <div id="diagram-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-slate-950/90 backdrop-blur-md">
      <div class="relative bg-slate-900 border border-slate-800 rounded-2xl max-w-5xl w-full p-6 text-slate-100 shadow-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
          <h3 class="text-xl font-bold text-white">Topología de Red &amp; Control ZAIKURAI</h3>
          <button id="close-modal-btn" type="button" aria-label="Cerrar modal" class="text-slate-400 hover:text-white p-2">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="flex items-center justify-center overflow-hidden rounded-xl border border-slate-800 p-2 bg-slate-950">
          <Image 
            src={diagramaArquitectura} 
            alt="Diagrama Ampliado ZAIKURAI"
            class="w-full h-auto object-contain max-h-[75vh]"
          />
        </div>
      </div>
    </div>

    <!-- SCRIPT DE ROTACIÓN ALEATORIA Y EVENTOS -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Rotación Aleatoria de Imágenes de Fondo IoT
        const slides = document.querySelectorAll('.hero-bg-slide');
        if (slides.length > 0) {
          let currentIndex = 0;
          setInterval(() => {
            slides[currentIndex].classList.remove('opacity-80');
            slides[currentIndex].classList.add('opacity-0');

            // Generación de índice aleatorio que no sea el mismo actual
            let nextIndex = Math.floor(Math.random() * slides.length);
            if (nextIndex === currentIndex) {
              nextIndex = (currentIndex + 1) % slides.length;
            }
            currentIndex = nextIndex;

            slides[currentIndex].classList.remove('opacity-0');
            slides[currentIndex].classList.add('opacity-80');
          }, 4500);
        }

        // 2. Menú Móvil
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const iconBars = document.getElementById('menu-icon-bars');
        const iconClose = document.getElementById('menu-icon-close');
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');

        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
              mobileMenu.classList.remove('hidden');
              mobileMenu.classList.add('flex');
              iconBars?.classList.replace('block', 'hidden');
              iconClose?.classList.replace('hidden', 'block');
            } else {
              mobileMenu.classList.add('hidden');
              mobileMenu.classList.remove('flex');
              iconBars?.classList.replace('hidden', 'block');
              iconClose?.classList.replace('block', 'hidden');
            }
          });

          mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
              mobileMenu.classList.add('hidden');
              mobileMenu.classList.remove('flex');
              iconBars?.classList.replace('hidden', 'block');
              iconClose?.classList.replace('block', 'hidden');
            });
          });
        }

        // 3. Modal de Diagrama de Arquitectura
        const openDiagramBtn = document.getElementById('open-diagram-btn');
        const diagramTrigger = document.getElementById('diagram-trigger');
        const diagramModal = document.getElementById('diagram-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');

        const toggleModal = (show) => {
          if (diagramModal) {
            if (show) {
              diagramModal.classList.remove('hidden');
              diagramModal.classList.add('flex');
              document.body.style.overflow = 'hidden';
            } else {
              diagramModal.classList.add('hidden');
              diagramModal.classList.remove('flex');
              document.body.style.overflow = '';
            }
          }
        };

        if (openDiagramBtn) openDiagramBtn.addEventListener('click', () => toggleModal(true));
        if (diagramTrigger) diagramTrigger.addEventListener('click', () => toggleModal(true));
        if (closeModalBtn) closeModalBtn.addEventListener('click', () => toggleModal(false));

        if (diagramModal) {
          diagramModal.addEventListener('click', (e) => {
            if (e.target === diagramModal) toggleModal(false);
          });
        }
      });
    </script>
  </body>
</html>
